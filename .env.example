# Copy to .env for a local container, or map the same variables from
# Kubernetes ConfigMaps/Secrets. Never commit real credentials.

# Runtime persistence/selection
SYSTEMONE_BENCHMARK_FILE=
SYSTEMONE_TELEMETRY_FILE=
SYSTEMONE_CALIBRATION_PROFILES=

# Provider instances are arbitrary deployment labels.
# The runtime does not assign meaning to "primary" or "secondary".
SYSTEMONE_PROVIDER_IDS=primary,secondary
SYSTEMONE_DEFAULT_PROVIDER=primary

# Instance: primary
SYSTEMONE_PROVIDER_PRIMARY_DRIVER=openai_compatible
SYSTEMONE_PROVIDER_PRIMARY_BASE_URL=
SYSTEMONE_PROVIDER_PRIMARY_MODEL=
SYSTEMONE_PROVIDER_PRIMARY_API_KEY=
SYSTEMONE_PROVIDER_PRIMARY_TIMEOUT_S=60
SYSTEMONE_PROVIDER_PRIMARY_MAX_PARALLEL=8

# Instance: secondary
# This can point to another cloud endpoint, a local endpoint, or another model.
SYSTEMONE_PROVIDER_SECONDARY_DRIVER=openai_compatible
SYSTEMONE_PROVIDER_SECONDARY_BASE_URL=
SYSTEMONE_PROVIDER_SECONDARY_MODEL=
SYSTEMONE_PROVIDER_SECONDARY_API_KEY=
SYSTEMONE_PROVIDER_SECONDARY_TIMEOUT_S=60
SYSTEMONE_PROVIDER_SECONDARY_MAX_PARALLEL=8

# Built-in protocol drivers:
#   openai_compatible  -> /chat/completions + token logprobs
#   systemone_http     -> /v1/systemone compatible API
# Custom drivers may use:
#   python:package.module:ProviderClass
#
# Provider/model brands are never hardcoded into the runtime. Change the
# instance environment to change deployment behavior.

# Legacy v1 API only. Leave empty unless the old /v1/decide endpoint is used.
DECIDE_BASE_URL=
DECIDE_API_KEY=
DECIDE_MODEL=
DECIDE_TIMEOUT_S=60
DECIDE_MAX_PARALLEL=8
DECIDE_DATA_DIR=

# RAG example service
RAG_PORT=8001
RAG_INGEST_ON_STARTUP=false
RAG_STARTUP_COLLECTIONS=engineering,business
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# Chroma behavior:
# remote                     -> fail if remote Chroma is unavailable
# local                      -> always use local persistent Chroma
# remote_with_local_fallback -> explicit development fallback
CHROMA_MODE=remote
CHROMA_HOST=localhost
CHROMA_PORT=8000
