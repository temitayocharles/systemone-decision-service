# Copy to .env for a local container, or map the same variables from
# Kubernetes ConfigMaps/Secrets. Never commit real credentials.
#
# Pre-filled for the local compose stack: cp .env.example .env and the
# primary instance points at the bundled Ollama service. Swap the values
# below for real deployments.

# Runtime persistence/selection
SYSTEMONE_BENCHMARK_FILE=
SYSTEMONE_TELEMETRY_FILE=
SYSTEMONE_CALIBRATION_PROFILES=

# Provider instances are arbitrary deployment labels.
SYSTEMONE_PROVIDER_IDS=primary
SYSTEMONE_DEFAULT_PROVIDER=primary

# Instance: primary (local Ollama, keyless)
SYSTEMONE_PROVIDER_PRIMARY_DRIVER=openai_compatible
SYSTEMONE_PROVIDER_PRIMARY_BASE_URL=http://ollama:11434/v1
SYSTEMONE_PROVIDER_PRIMARY_MODEL=qwen2.5:3b
SYSTEMONE_PROVIDER_PRIMARY_API_KEY=
SYSTEMONE_PROVIDER_PRIMARY_TIMEOUT_S=60
SYSTEMONE_PROVIDER_PRIMARY_MAX_PARALLEL=8
SYSTEMONE_PROVIDER_PRIMARY_CAPABILITIES=private_runtime
SYSTEMONE_PROVIDER_PRIMARY_ATTRIBUTES_JSON='{"local":true}'

# Instance: secondary (template, uncomment and fill for a second backend)
#SYSTEMONE_PROVIDER_SECONDARY_DRIVER=openai_compatible
#SYSTEMONE_PROVIDER_SECONDARY_BASE_URL=
#SYSTEMONE_PROVIDER_SECONDARY_MODEL=
#SYSTEMONE_PROVIDER_SECONDARY_API_KEY=
#SYSTEMONE_PROVIDER_SECONDARY_TIMEOUT_S=60
#SYSTEMONE_PROVIDER_SECONDARY_MAX_PARALLEL=8
#SYSTEMONE_PROVIDER_SECONDARY_CAPABILITIES=
#SYSTEMONE_PROVIDER_SECONDARY_ATTRIBUTES_JSON={}
# Add "secondary" to SYSTEMONE_PROVIDER_IDS above to enable it.

# CAPABILITIES is an arbitrary comma-separated set, for example:
# private_runtime,multimodal,structured_output,streaming
#
# ATTRIBUTES_JSON is arbitrary typed metadata used by routing policies, e.g.:
# {"local":true,"max_context":32768,"region":"ca-central"}
#
# Drivers also derive protocol capabilities automatically:
# openai_compatible -> chat_completions, token_logprobs, probabilistic_decisions
# systemone_http    -> native_systemone, probabilistic_decisions
#
# Custom drivers:
# SYSTEMONE_PROVIDER_X_DRIVER=python:package.module:ProviderClass

# RAG example service
RAG_PORT=8001
RAG_INGEST_ON_STARTUP=false
RAG_STARTUP_COLLECTIONS=engineering,business
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

CHROMA_MODE=remote
CHROMA_HOST=localhost
CHROMA_PORT=8000
