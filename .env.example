# Copy to .env and fill in. Never commit a real .env.

# Runtime
SYSTEMONE_DEFAULT_PROVIDER=openai_compatible
SYSTEMONE_PROVIDERS=openai_compatible,jev
SYSTEMONE_BENCHMARK_FILE=
SYSTEMONE_TELEMETRY_FILE=
SYSTEMONE_CALIBRATION_PROFILES=

# OpenAI-compatible logprob provider
DECIDE_BASE_URL=https://integrate.api.nvidia.com/v1
DECIDE_API_KEY=
DECIDE_MODEL=meta/llama-3.1-70b-instruct
DECIDE_TIMEOUT_S=60
DECIDE_MAX_PARALLEL=8
DECIDE_DATA_DIR=

# Jev provider
JEV_BASE_URL=https://jevmodel.org
JEVMODEL_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=20

# RAG example service
RAG_PORT=8001
RAG_INGEST_ON_STARTUP=false
RAG_STARTUP_COLLECTIONS=engineering,business
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# Chroma behavior:
# remote                 -> fail if remote Chroma is unavailable
# local                  -> always use local persistent Chroma
# remote_with_local_fallback -> explicit development fallback
CHROMA_MODE=remote
CHROMA_HOST=localhost
CHROMA_PORT=8000
