# Copy to .env and fill in. Never commit a real .env.

# Decision service model provider: any OpenAI-compatible chat-completions
# endpoint that returns logprobs (NVIDIA, Ollama with a compatible proxy, etc.)
DECIDE_BASE_URL=https://integrate.api.nvidia.com/v1
DECIDE_API_KEY=
DECIDE_MODEL=meta/llama-3.1-70b-instruct
DECIDE_TIMEOUT_S=60
DECIDE_MAX_PARALLEL=8

# RAG service (Ollama for embeddings + generation, ChromaDB for vectors)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1
CHROMA_HOST=localhost
CHROMA_PORT=8000
